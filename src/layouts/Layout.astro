---
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Uriel Gandelman" } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b100e" />
    <meta
      name="description"
      content="Soy Uriel, desarrollador de Buenos Aires. Construyo aplicaciones, sistemas e ideas con inteligencia artificial. Conocé mis proyectos."
    />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Aplicaciones, sistemas e ideas. El portfolio de Uriel Gandelman."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/images/ug-matrix.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
