---
import { projects } from "../data/projects";
---

<section
  class="profile"
  id="terminal"
  aria-label="Terminal del portfolio"
  data-terminal
>
  <div class="profile-header">
    <span class="shell-title">uriel@portfolio</span>
    <span data-terminal-path>~/portfolio</span>
  </div>
  <div class="pixel-mark">
    <img src="/images/ug-matrix.svg" width="514" height="173" alt="" />
  </div>
  <div class="terminal-log" role="log" aria-label="Resultados de la consola">
    <div data-entry>
      <p data-prompt>
        <span aria-hidden="true">$ </span>
        <span>whoami</span>
      </p>
      <div data-response>
        Uriel Gandelman · Buenos Aires
        <br />
        Desarrollador de software
      </div>
    </div>
  </div>

  <div hidden data-terminal-controls>
    <div class="command-suggestions" aria-label="Comandos rápidos">
      <button type="button" data-command="ls ~/portfolio/proyectos">
        ls <span>Proyectos</span>
      </button>
      <button type="button" data-command="cat ~/portfolio/sobre-mi.md">
        cat <span>Sobre mí</span>
      </button>
      <button type="button" data-command="help">
        help
      </button>
    </div>
    <form aria-label="Consola interactiva">
      <label for="terminal-command">
        <span aria-hidden="true">$</span>
        <span class="sr-only">Comando</span>
      </label>
      <input
        id="terminal-command"
        name="command"
        placeholder="Escribí un comando…"
        maxlength="120"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button type="submit">Ejecutar</button>
    </form>
  </div>

  <template data-projects>
    <ul class="terminal-links">
      {projects.map((project) => (
        <li>
          <a href={`#${project.slug}`}>{project.slug}</a>
        </li>
      ))}
    </ul>
  </template>

  <template data-entry-template>
    <div data-entry>
      <p data-prompt>
        <span aria-hidden="true">$ </span>
        <span data-command-text></span>
      </p>
      <div data-response></div>
    </div>
  </template>
</section>

<script>
  import "../scripts/terminal-input";
</script>

<style>
  .shell-title {
    color: var(--green);
  }
  .profile-header {
    flex-wrap: wrap;
    gap: 6px 12px;
  }
  .terminal-log {
    border-top: 1px solid var(--border);
    padding: 16px 24px;
    min-height: 104px;
    max-height: 240px;
    overflow-y: auto;
    color: var(--text);
    font: 13px/1.7 var(--mono);
    overflow-wrap: anywhere;
  }
  [data-entry] + [data-entry] {
    margin-top: 14px;
  }
  [data-prompt] {
    color: var(--green);
    margin-bottom: 5px;
  }
  [data-response] :global(p + p),
  [data-response] :global(ul) {
    margin-top: 6px;
  }
  [data-response] :global(ul:not(.terminal-links)) {
    padding-left: 18px;
  }
  .terminal-links {
    padding: 0;
    margin: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .terminal-log :global(a) {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .command-suggestions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 0 24px 12px;
  }
  button {
    cursor: pointer;
    color: var(--green);
    font: 12px/1.4 var(--mono);
  }
  .command-suggestions button {
    min-height: 36px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 5px 8px;
  }
  .command-suggestions span {
    color: var(--muted);
  }
  form {
    display: flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--border);
    background: var(--background);
    padding: 5px 16px 5px 24px;
  }
  label {
    color: var(--green);
    font: 14px var(--mono);
  }
  input {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--text);
    caret-color: var(--green);
    font: 14px var(--mono);
  }
  input::placeholder {
    color: var(--subtle);
  }
  form button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 0 5px;
  }
  button:hover {
    color: var(--text);
  }
  @media (max-width: 700px) {
    .terminal-log,
    .command-suggestions {
      padding-inline: 15px;
    }
    form {
      padding-inline: 15px;
    }
    input {
      font-size: 16px;
    }
  }
</style>
