---
import { projects } from "../data/projects";
---

<section
  class="profile"
  id="terminal"
  aria-label="Terminal del portfolio"
  data-terminal
>
  <div class="pixel-mark">
    <img src="/images/ug-matrix.svg" width="514" height="173" alt="" />
  </div>
  <div class="terminal-log" role="log" aria-label="Resultados de la consola">
    <div data-entry>
      <p data-prompt>
        <span aria-hidden="true">$ </span>
        <span>whoami</span>
      </p>
      <div data-response>
        <dl>
          <div>
            <dt>nombre</dt>
            <dd>Uriel Gandelman</dd>
          </div>
          <div>
            <dt>edad</dt>
            <dd>18</dd>
          </div>
          <div>
            <dt>ciudad</dt>
            <dd>Buenos Aires, Argentina</dd>
          </div>
          <div>
            <dt>estudio</dt>
            <dd>TIC en ORT Argentina, último año</dd>
          </div>
          <div>
            <dt>publicado</dt>
            <dd>StepByStories, en iOS y Android</dd>
          </div>
          <div>
            <dt>ahora</dt>
            <dd>TraidX</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div hidden data-terminal-controls>
    <div class="command-suggestions" aria-label="Comandos rápidos">
      <button type="button" data-command="ls ~/portfolio/proyectos">
        ls <span>Proyectos</span>
      </button>
      <button type="button" data-command="cat ~/portfolio/sobre-mi.md">
        cat <span>Sobre mí</span>
      </button>
      <button type="button" data-command="help">
        help
      </button>
    </div>
    <form aria-label="Consola interactiva">
      <label for="terminal-command">
        <span data-terminal-path>~/portfolio</span>
        <span aria-hidden="true">$</span>
        <span class="sr-only">Comando</span>
      </label>
      <input
        id="terminal-command"
        name="command"
        placeholder="Escribí un comando…"
        maxlength="120"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button type="submit">Ejecutar</button>
    </form>
  </div>

  <template data-projects>
    <ul class="terminal-links">
      {projects.map((project) => (
        <li>
          <a href={`#${project.slug}`}>{project.slug}</a>
        </li>
      ))}
    </ul>
  </template>

  <template data-entry-template>
    <div data-entry>
      <p data-prompt>
        <span aria-hidden="true">$ </span>
        <span data-command-text></span>
      </p>
      <div data-response></div>
    </div>
  </template>
</section>

<script>
  import "../scripts/terminal-input";
</script>

<style>
  .terminal-log {
    max-height: 330px;
    overflow-y: auto;
    color: var(--text);
    font: 14px/1.6 var(--mono);
    overflow-wrap: anywhere;
  }
  [data-entry] + [data-entry] {
    margin-top: 14px;
  }
  [data-prompt] {
    color: var(--green);
    margin-bottom: 8px;
  }
  dl {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  dl div {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--subtle);
  }
  dd {
    margin: 0;
  }
  [data-response] :global(p + p),
  [data-response] :global(ul) {
    margin-top: 6px;
  }
  [data-response] :global(ul:not(.terminal-links)) {
    padding-left: 18px;
  }
  .terminal-links {
    padding: 0;
    margin: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .terminal-log :global(a) {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .command-suggestions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 16px 0 12px;
  }
  button {
    cursor: pointer;
    color: var(--green);
    font: 12px/1.4 var(--mono);
  }
  .command-suggestions button {
    min-height: 36px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 5px 8px;
  }
  .command-suggestions span {
    color: var(--muted);
  }
  form {
    display: flex;
    align-items: center;
    gap: 10px;
    border-block: 1px solid var(--border);
  }
  label {
    display: flex;
    gap: 8px;
    color: var(--green);
    font: 14px var(--mono);
  }
  label [data-terminal-path] {
    color: var(--subtle);
  }
  input {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--text);
    caret-color: var(--green);
    font: 14px var(--mono);
  }
  input::placeholder {
    color: var(--subtle);
  }
  form button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 0 5px;
  }
  button:hover {
    color: var(--text);
  }
  @media (max-width: 700px) {
    .terminal-log {
      font-size: 13px;
    }
    dl div {
      grid-template-columns: 90px minmax(0, 1fr);
    }
    input {
      font-size: 16px;
    }
  }
</style>
