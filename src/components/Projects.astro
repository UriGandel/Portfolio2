---
import Command from "./Command.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section id="proyectos" class="projects" aria-labelledby="projects-title">
  <div class="projects-heading">
    <Command text="ls ./proyectos" />
    <h2 id="projects-title">Proyectos</h2>
    <nav class="project-index" aria-label="Ir a un proyecto">
      {projects.map((project) => (
        <a href={`#${project.slug}`}>
          {project.name}
          <span aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>
  </div>
  {projects.map((project) => (
    <ProjectCard project={project} />
  ))}
</section>

<style>
  .projects-heading {
    padding-top: 61px;
    padding-bottom: 57px;
  }
  h2 {
    font-size: 59px;
    line-height: 1;
    font-weight: 500;
    margin: 15px 0 20px;
  }
  .project-index {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  .project-index a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    padding: 16px 15px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    font: 14px/20px var(--mono);
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }
  .project-index span {
    color: var(--green);
    padding-left: 8px;
  }
  @media (hover: hover) and (pointer: fine) {
    .project-index a:hover {
      border-color: var(--green);
      background: var(--preview);
    }
  }
  @media (max-width: 1100px) {
    .project-index {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .projects-heading {
      padding-top: 40px;
      padding-bottom: 16px;
    }
    h2 {
      font-size: 42px;
    }
    .project-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .project-index a {
      font-size: 11px;
      min-height: 46px;
      padding: 10px;
    }
  }
</style>
