---
import Command from "./Command.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section id="proyectos" class="projects" aria-labelledby="projects-title">
  <div class="projects-heading" data-reveal>
    <Command text="ls -l ./proyectos" />
    <h2 id="projects-title" class="sr-only">
      Proyectos
    </h2>
    <table>
      <thead>
        <tr>
          <th>nombre</th>
          <th>qué es</th>
          <th>estado</th>
          <th>año</th>
          <th>stack</th>
        </tr>
      </thead>
      <tbody>
        {projects.map((project) => (
          <tr>
            <td>
              <a href={`#${project.slug}`}>{project.slug}</a>
            </td>
            <td>{project.kind}</td>
            <td>{project.status}</td>
            <td>{project.year}</td>
            <td>{project.stack}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {projects.map((project) => (
    <ProjectCard project={project} />
  ))}
</section>

<style>
  .projects-heading {
    padding-top: 48px;
    padding-bottom: 57px;
  }
  td:nth-child(2) {
    color: var(--text);
  }
  td a {
    color: var(--green);
  }
  @media (hover: hover) and (pointer: fine) {
    td a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
  @media (max-width: 1100px) {
    th:last-child,
    td:last-child {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .projects-heading {
      padding-top: 40px;
      padding-bottom: 16px;
    }
    th:nth-child(n + 3),
    td:nth-child(n + 3) {
      display: none;
    }
  }
</style>
